      "text": "Un segundo...",
      "start": 15,
      "end": 16.2,
      "look": "valentina"
    },
    {
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 17,
      "end": 19.4,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 20,

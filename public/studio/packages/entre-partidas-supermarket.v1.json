  "dialogue": [
    {
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2,
      "end": 5.5,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6,
      "end": 9.4,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "Bruno...",
      "start": 12,
      "end": 13,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "Bruno.",
      "start": 14,

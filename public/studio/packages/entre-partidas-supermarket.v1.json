  "dialogue": [
    {
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2,
      "end": 5.467,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6,
      "end": 9.653,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "¡Bruno, Bruno!",
      "start": 11,
      "end": 12.2,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Un segundo...",
      "start": 13.1,
      "end": 14.761,
      "look": "valentina"
    },
    {
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 14.811,
      "end": 17.048,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 17.389,
      "end": 19.05,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "start": 19.389,
      "end": 22.022,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "El Desafío Diario de mañana lo quiero hacer bien.",
      "start": 22.389,
      "end": 25.154,
      "look": "martina"
    },
    {
      "speaker": "martina",
      "text": "Ah... ¿y ya sabés qué producto va a salir?",
      "start": 26.389,
      "end": 28.998,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "No.",
      "start": 29.389,
      "end": 31.05,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "start": 31.1,
      "end": 32.761,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando. Puede tocar cualquier producto. Son quince segundos.",
      "start": 32.811,
      "end": 38.792,
      "look": "martina"
    },
    {
      "speaker": "martina",
      "text": "¿Y tu plan es leer todos los productos del supermercado?",
      "start": 38.842,
      "end": 41.847,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "start": 42.389,
      "end": 48.088,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "start": 48.138,
      "end": 50.099,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Después.",
      "start": 50.149,
      "end": 51.81,
      "look": "valentina"
    },
    {
      "speaker": "martina",
      "text": "¿Viniste solo a estudiar?",
      "start": 51.86,
      "end": 53.773,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "start": 55.389,
      "end": 57.464,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Sí, sí...",
      "start": 57.789,
      "end": 59.45,
      "look": "valentina"
    }
  ],

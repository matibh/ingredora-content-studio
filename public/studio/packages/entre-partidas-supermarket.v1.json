  "dialogue": [
    {
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2,
      "end": 5.467,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6,
      "end": 9.653,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "Bruno",
      "start": 9.8,
      "end": 10.3,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Un segundo...",
      "start": 10.5,
      "end": 12.161,
      "look": "valentina"
    },
    {
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 12.211,
      "end": 14.448,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 14.789,
      "end": 16.45,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "start": 16.789,
      "end": 19.422,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "El Desafío Diario de mañana lo quiero hacer bien.",
      "start": 19.789,
      "end": 22.989,
      "look": "martina"
    },
    {
      "speaker": "martina",
      "text": "Ah... ¿y ya sabés qué producto va a salir?",
      "start": 23.789,
      "end": 26.398,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "No.",
      "start": 26.789,
      "end": 28.45,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "start": 28.5,
      "end": 30.161,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando. Puede tocar cualquier producto. Son quince segundos.",
      "start": 30.211,
      "end": 36.192,
      "look": "martina"
    },
    {
      "speaker": "martina",
      "text": "¿Y tu plan es leer todos los productos del supermercado?",
      "start": 36.242,
      "end": 39.247,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "start": 39.789,
      "end": 45.488,
      "look": "martina"
    },
    {
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "start": 45.538,
      "end": 47.499,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Después.",
      "start": 47.549,
      "end": 49.21,
      "look": "valentina"
    },
    {
      "speaker": "martina",
      "text": "¿Viniste solo a estudiar?",
      "start": 49.26,
      "end": 51.173,
      "look": "bruno"
    },
    {
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "start": 52.789,
      "end": 54.864,
      "look": "bruno"
    },
    {
      "speaker": "bruno",
      "text": "Sí, sí...",
      "start": 55.189,
      "end": 56.85,
      "look": "valentina"
    }
  ],

  "dialogue": [
    {
      "speaker": "tomas",
      "text": "Uhhh, hoy está difícil esto...",
      "start": 5,
      "end": 7.8,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "No, pará... yo esto lo saco. Tengo un método.",
      "start": 9,
      "end": 13,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "¡JA! ¡Era obvio!",
      "start": 43,
      "end": 45,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "¡Vamos! ¡Primer puesto!",
      "start": 47,
      "end": 50,
      "look": "tomas"
    },
    {
      "speaker": "ernesto",
      "text": "¿Qué estás haciendo, Tomás?",
      "start": 54,
      "end": 57,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Nada... comprando.",
      "start": 58,
      "end": 60,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "¿Comprando? ¡Tenés el celular en una mano y la Nutella en la otra!",
      "start": 61,
      "end": 66,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Es que me dio hambre.",
      "start": 67,
      "end": 69,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "¿Vos sabés lo que significa un desafío diario? ¡Desafío! ¡No es ir al supermercado a buscar las respuestas!",
      "start": 72,
      "end": 80,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Pero Ernesto, técnicamente no hice trampa... el producto estaba ahí.",
      "start": 81,
      "end": 87,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "¡Claro! Y si mañana el desafío es de geografía, ¿te vas a parar al lado de un globo terráqueo?",
      "start": 88,
      "end": 96,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Y... depende de cuánto cueste.",
      "start": 97,
      "end": 100,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "¡El juego se gana pensando! ¡No mirando las etiquetas de los productos!",
      "start": 101,
      "end": 107,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Bueno, pero gané.",
      "start": 108,
      "end": 110,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "¡No ganaste nada! ¡Te engañaste a vos mismo!",
      "start": 110.5,
      "end": 114,
      "look": "tomas"
    },
    {
      "speaker": "tomas",
      "text": "Bueno, listo. Mañana juego limpio.",
      "start": 115,
      "end": 118,
      "look": "ernesto"
    },
    {
      "speaker": "tomas",
      "text": "Igual... ¿me comprás la Nutella?",
      "start": 118.5,
      "end": 121.5,
      "look": "ernesto"
    },
    {
      "speaker": "ernesto",
      "text": "Dios dame paciencia...",
      "start": 122,
      "end": 124,
      "look": "tomas"
    }
  ],

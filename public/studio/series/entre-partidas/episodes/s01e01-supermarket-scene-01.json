  "dialogue": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina.",
      "startSeconds": 0.5,
      "endSeconds": 4,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "neutral"
    },
    {
      "id": "02-martina",
      "speaker": "martina",
      "text": "¿Qué está haciendo?",
      "startSeconds": 4.2,
      "endSeconds": 5.8,
      "lookAt": "valentina",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "03-valentina",
      "speaker": "valentina",
      "text": "Mirá.",
      "startSeconds": 6,
      "endSeconds": 6.6,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "smile"
    },
    {
      "id": "04-valentina",
      "speaker": "valentina",
      "text": "Bruno...",
      "startSeconds": 6.8,
      "endSeconds": 7.7,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "neutral"
    },
    {
      "id": "05-valentina",
      "speaker": "valentina",
      "text": "Bruno.",
      "startSeconds": 8,
      "endSeconds": 8.7,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "06-bruno",
      "speaker": "bruno",
      "text": "Un segundo...",
      "startSeconds": 9,
      "endSeconds": 10,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "neutral"
    },
    {
      "id": "07-martina",
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "startSeconds": 10.3,
      "endSeconds": 12.5,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "08-bruno",
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "startSeconds": 12.8,
      "endSeconds": 14.3,
      "lookAt": "martina",
      "gesture": "open-hand",
      "expression": "neutral"
    },
    {
      "id": "09-valentina",
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "startSeconds": 14.6,
      "endSeconds": 17.1,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "smile"
    },
    {
      "id": "10-bruno",
      "speaker": "bruno",
      "text": "Mañana es el Desafío Diario. Esta vez lo quiero hacer bien.",
      "startSeconds": 17.4,
      "endSeconds": 21.2,
      "lookAt": "martina",
      "gesture": "open-hand",
      "expression": "neutral"
    },
    {
      "id": "11-martina",
      "speaker": "martina",
      "text": "¿Y ya sabés qué producto va a salir?",
      "startSeconds": 21.5,
      "endSeconds": 24,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "12-bruno",
      "speaker": "bruno",
      "text": "No.",
      "startSeconds": 24.3,
      "endSeconds": 24.8,
      "lookAt": "martina",
      "gesture": "none",
      "expression": "neutral"
    },
    {
      "id": "13-valentina",
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "startSeconds": 25.1,
      "endSeconds": 26,
      "lookAt": "martina",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "14-bruno",
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando.",
      "startSeconds": 26.3,
      "endSeconds": 28.6,
      "lookAt": "valentina",
      "gesture": "open-hand",
      "expression": "neutral"
    },
    {
      "id": "15-bruno",
      "speaker": "bruno",
      "text": "Puede tocar cualquier producto. Son quince segundos. No puedo quedarme pensando qué significa cada ingrediente.",
      "startSeconds": 28.9,
      "endSeconds": 34,
      "lookAt": "martina",
      "gesture": "open-hand",
      "expression": "neutral"
    },
    {
      "id": "16-martina",
      "speaker": "martina",
      "text": "¿Tu plan es leer todos los productos del supermercado?",
      "startSeconds": 34.3,
      "endSeconds": 37,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "skeptical"
    },
    {
      "id": "17-bruno",
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "startSeconds": 37.3,
      "endSeconds": 41.5,
      "lookAt": "martina",
      "gesture": "point",
      "expression": "neutral"
    },
    {
      "id": "18-valentina",
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "startSeconds": 41.8,
      "endSeconds": 44,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "smile"
    },
    {
      "id": "19-bruno",
      "speaker": "bruno",
      "text": "Después.",
      "startSeconds": 44.3,
      "endSeconds": 45.1,
      "lookAt": "valentina",
      "gesture": "none",
      "expression": "neutral"
    },
    {
      "id": "20-valentina",
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "startSeconds": 45.5,
      "endSeconds": 47.5,
      "lookAt": "bruno",
      "gesture": "none",
      "expression": "smile"
    },
    {
      "id": "21-bruno",
      "speaker": "bruno",
      "text": "Sí, sí...",
      "startSeconds": 47.8,
      "endSeconds": 48.8,
      "lookAt": "valentina",
      "gesture": "none",
      "expression": "neutral"
    }
  ],

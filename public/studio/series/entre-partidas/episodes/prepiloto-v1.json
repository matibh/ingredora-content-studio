  "dialogue": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Yo nunca pierdo. El juego a veces no entiende mi estrategia.",
      "startSeconds": 0.45,
      "endSeconds": 5.274,
      "lookAt": "martina",
      "gesture": "open-hand",
      "expression": "smile"
    },
    {
      "id": "02-martina",
      "speaker": "martina",
      "text": "No es el juego. Es que no sabés perder.",
      "startSeconds": 5.554,
      "endSeconds": 9.85,
      "lookAt": "bruno",
      "gesture": "point",
      "expression": "skeptical"
    },
    {
      "id": "03-tomas",
      "speaker": "tomas",
      "text": "Pará, tengo una teoría. Capaz el juego detecta el miedo.",
      "startSeconds": 10.2,
      "endSeconds": 14.616,
      "lookAt": "valentina",
      "gesture": "open-hand",
      "expression": "smile"
    },
    {
      "id": "04-valentina",
      "speaker": "valentina",
      "text": "Entonces a vos te detecta desde la puerta.",
      "startSeconds": 14.916,
      "endSeconds": 18.324,
      "lookAt": "bruno",
      "gesture": "point",
      "expression": "skeptical"
    },
    {
      "id": "05-ernesto",
      "speaker": "ernesto",
      "text": "En mis tiempos, para perder así, había que salir de casa.",
      "startSeconds": 18.744,
      "endSeconds": 23.616,
      "lookAt": "bruno",
      "gesture": "shrug",
      "expression": "smile"
    },
    {
      "id": "06-bruno",
      "speaker": "bruno",
      "text": "Bueno, ¿podemos hablar de otra cosa?",
      "startSeconds": 23.936,
      "endSeconds": 26.816,
      "lookAt": "martina",
      "gesture": "shrug",
      "expression": "surprised"
    },
    {
      "id": "07-martina",
      "speaker": "martina",
      "text": "Tarde. Ya estamos grabando.",
      "startSeconds": 27.166,
      "endSeconds": 30.862,
      "lookAt": "camera",
      "gesture": "none",
      "expression": "smile"
    },
    {
      "id": "08-ernesto",
      "speaker": "ernesto",
      "text": "¿Saludamos?",
      "startSeconds": 31.612,
      "endSeconds": 33.556,
      "lookAt": "camera",

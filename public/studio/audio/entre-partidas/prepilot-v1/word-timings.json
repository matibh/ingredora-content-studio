  "segments": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Yo nunca pierdo. El juego a veces no entiende mi estrategia.",
      "start": 0.45,
      "end": 5.274,
      "durationSeconds": 4.824,
      "voice": "es-AR-TomasNeural",
      "wordCount": 11
    },
    {
      "id": "02-martina",
      "speaker": "martina",
      "text": "No es el juego. Es que no sabés perder.",
      "start": 5.554,
      "end": 9.85,
      "durationSeconds": 4.296,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 9
    },
    {
      "id": "03-tomas",
      "speaker": "tomas",
      "text": "Pará, tengo una teoría. Capaz el juego detecta el miedo.",
      "start": 10.2,
      "end": 14.616,
      "durationSeconds": 4.416,
      "voice": "es-UY-MateoNeural",
      "wordCount": 10
    },
    {
      "id": "04-valentina",
      "speaker": "valentina",
      "text": "Entonces a vos te detecta desde la puerta.",
      "start": 14.916,
      "end": 18.324,
      "durationSeconds": 3.408,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 8
    },
    {
      "id": "05-ernesto",
      "speaker": "ernesto",
      "text": "En mis tiempos, para perder así, había que salir de casa.",
      "start": 18.744,
      "end": 23.616,
      "durationSeconds": 4.872,
      "voice": "es-CL-LorenzoNeural",
      "wordCount": 11
    },
    {
      "id": "06-bruno",
      "speaker": "bruno",
      "text": "Bueno, ¿podemos hablar de otra cosa?",
      "start": 23.936,
      "end": 26.816,
      "durationSeconds": 2.88,
      "voice": "es-AR-TomasNeural",
      "wordCount": 6
    },
    {
      "id": "07-martina",
      "speaker": "martina",
      "text": "Tarde. Ya estamos grabando.",
      "start": 27.166,
      "end": 30.862,
      "durationSeconds": 3.696,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "08-ernesto",
      "speaker": "ernesto",
      "text": "¿Saludamos?",
      "start": 31.612,
      "end": 33.556,
      "durationSeconds": 1.944,
      "voice": "es-CL-LorenzoNeural",
      "wordCount": 1
    }
  ]
}
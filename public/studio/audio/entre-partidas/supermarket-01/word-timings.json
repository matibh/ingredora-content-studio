  "segments": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2.0,
      "end": 5.467,
      "voice": "es-AR-TomasNeural",
      "wordCount": 7
    },
    {
      "id": "02-bruno",
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6.0,
      "end": 9.653,
      "voice": "es-AR-TomasNeural",
      "wordCount": 8
    },
    {
      "id": "03-valentina",
      "speaker": "valentina",
      "text": "Bruno...",
      "start": 12.0,
      "end": 13.193,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 1
    },
    {
      "id": "04-valentina",
      "speaker": "valentina",
      "text": "Bruno.",
      "start": 14.0,
      "end": 15.661,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 1
    },
    {
      "id": "05-bruno",
      "speaker": "bruno",
      "text": "Un segundo...",
      "start": 15.711,
      "end": 17.372,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    },
    {
      "id": "06-martina",
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 17.422,
      "end": 19.659,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "07-bruno",
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 20.0,
      "end": 21.661,
      "voice": "es-AR-TomasNeural",
      "wordCount": 3
    },
    {
      "id": "08-valentina",
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "start": 22.0,
      "end": 24.633,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "09-bruno",
      "speaker": "bruno",
      "text": "Mañana es el Desafío Diario. Esta vez lo quiero hacer bien.",
      "start": 25.0,
      "end": 28.773,
      "voice": "es-AR-TomasNeural",
      "wordCount": 11
    },
    {
      "id": "10-martina",
      "speaker": "martina",
      "text": "Ah... ¿y ya sabés qué producto va a salir?",
      "start": 29.0,
      "end": 31.609,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 9
    },
    {
      "id": "11-bruno",
      "speaker": "bruno",
      "text": "No.",
      "start": 32.0,
      "end": 33.661,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "12-valentina",
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "start": 33.711,
      "end": 35.372,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 2
    },
    {
      "id": "13-bruno",
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando. Puede tocar cualquier producto. Son quince segundos.",
      "start": 35.422,
      "end": 41.403,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "14-martina",
      "speaker": "martina",
      "text": "¿Y tu plan es leer todos los productos del supermercado?",
      "start": 41.453,
      "end": 44.458,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 10
    },
    {
      "id": "15-bruno",
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "start": 45.0,
      "end": 50.699,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "16-valentina",
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "start": 50.749,
      "end": 52.71,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "17-bruno",
      "speaker": "bruno",
      "text": "Después.",
      "start": 52.76,
      "end": 54.421,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "18-martina",
      "speaker": "martina",
      "text": "¿Viniste solo a estudiar?",
      "start": 54.471,
      "end": 56.384,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "19-valentina",
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "start": 58.0,
      "end": 60.075,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "20-bruno",
      "speaker": "bruno",
      "text": "Sí, sí...",
      "start": 60.4,
      "end": 62.061,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    }
  ]
}

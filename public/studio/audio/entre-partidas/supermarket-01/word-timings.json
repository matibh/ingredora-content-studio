  "segments": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2,
      "end": 5.467,
      "voice": "es-AR-TomasNeural",
      "wordCount": 7
    },
    {
      "id": "02-bruno",
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6,
      "end": 9.653,
      "voice": "es-AR-TomasNeural",
      "wordCount": 8
    },
    {
      "id": "03-valentina",
      "speaker": "valentina",
      "text": "Bruno",
      "start": 9.8,
      "end": 10.3,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 1
    },
    {
      "id": "04-bruno",
      "speaker": "bruno",
      "text": "Un segundo...",
      "start": 10.5,
      "end": 12.161,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    },
    {
      "id": "05-martina",
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 12.211,
      "end": 14.448,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "06-bruno",
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 14.789,
      "end": 16.45,
      "voice": "es-AR-TomasNeural",
      "wordCount": 3
    },
    {
      "id": "07-valentina",
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "start": 16.789,
      "end": 19.422,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "08-bruno",
      "speaker": "bruno",
      "text": "El Desafío Diario de mañana lo quiero hacer bien.",
      "start": 19.789,
      "end": 22.989,
      "voice": "es-AR-TomasNeural",
      "wordCount": 9
    },
    {
      "id": "09-martina",
      "speaker": "martina",
      "text": "Ah... ¿y ya sabés qué producto va a salir?",
      "start": 23.789,
      "end": 26.398,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 9
    },
    {
      "id": "10-bruno",
      "speaker": "bruno",
      "text": "No.",
      "start": 26.789,
      "end": 28.45,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "11-valentina",
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "start": 28.5,
      "end": 30.161,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 2
    },
    {
      "id": "12-bruno",
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando. Puede tocar cualquier producto. Son quince segundos.",
      "start": 30.211,
      "end": 36.192,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "13-martina",
      "speaker": "martina",
      "text": "¿Y tu plan es leer todos los productos del supermercado?",
      "start": 36.242,
      "end": 39.247,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 10
    },
    {
      "id": "14-bruno",
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "start": 39.789,
      "end": 45.488,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "15-valentina",
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "start": 45.538,
      "end": 47.499,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "16-bruno",
      "speaker": "bruno",
      "text": "Después.",
      "start": 47.549,
      "end": 49.21,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "17-martina",
      "speaker": "martina",
      "text": "¿Viniste solo a estudiar?",
      "start": 49.26,
      "end": 51.173,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "18-valentina",
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "start": 52.789,
      "end": 54.864,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "19-bruno",
      "speaker": "bruno",
      "text": "Sí, sí...",
      "start": 55.189,
      "end": 56.85,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    }
  ]
}

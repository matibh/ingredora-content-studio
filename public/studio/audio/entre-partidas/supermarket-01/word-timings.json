  "segments": [
    {
      "id": "01-bruno",
      "speaker": "bruno",
      "text": "Harina de trigo... azúcar... aceite vegetal... maltodextrina...",
      "start": 2,
      "end": 5.467,
      "voice": "es-AR-TomasNeural",
      "wordCount": 7
    },
    {
      "id": "02-bruno",
      "speaker": "bruno",
      "text": "¿Maltodextrina...? Bueno, esto también lo tengo que aprender.",
      "start": 6,
      "end": 9.653,
      "voice": "es-AR-TomasNeural",
      "wordCount": 8
    },
    {
      "id": "03-valentina",
      "speaker": "valentina",
      "text": "¡Bruno, Bruno!",
      "start": 11,
      "end": 12.2,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 2
    },
    {
      "id": "04-valentina-call",
      "speaker": "valentina",
      "text": "Bruno",
      "start": 11.63,
      "end": 12.15,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 1
    },
    {
      "id": "05-bruno",
      "speaker": "bruno",
      "text": "Un segundo...",
      "start": 13.1,
      "end": 14.761,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    },
    {
      "id": "06-martina",
      "speaker": "martina",
      "text": "¿Estás leyendo los ingredientes?",
      "start": 14.811,
      "end": 17.048,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "07-bruno",
      "speaker": "bruno",
      "text": "Me estoy preparando.",
      "start": 17.389,
      "end": 19.05,
      "voice": "es-AR-TomasNeural",
      "wordCount": 3
    },
    {
      "id": "08-valentina",
      "speaker": "valentina",
      "text": "¿Para qué? ¿Te toman examen?",
      "start": 19.389,
      "end": 22.022,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "09-bruno",
      "speaker": "bruno",
      "text": "El Desafío Diario de mañana lo quiero hacer bien.",
      "start": 22.389,
      "end": 25.334,
      "voice": "es-AR-TomasNeural",
      "wordCount": 9
    },
    {
      "id": "10-martina",
      "speaker": "martina",
      "text": "Ah... ¿y ya sabés qué producto va a salir?",
      "start": 26.389,
      "end": 28.998,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 9
    },
    {
      "id": "11-bruno",
      "speaker": "bruno",
      "text": "No.",
      "start": 29.389,
      "end": 31.05,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "12-valentina",
      "speaker": "valentina",
      "text": "Ah, bueno.",
      "start": 31.1,
      "end": 32.761,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 2
    },
    {
      "id": "13-bruno",
      "speaker": "bruno",
      "text": "Justamente. Por eso estoy estudiando. Puede tocar cualquier producto. Son quince segundos.",
      "start": 32.811,
      "end": 38.792,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "14-martina",
      "speaker": "martina",
      "text": "¿Y tu plan es leer todos los productos del supermercado?",
      "start": 38.842,
      "end": 41.847,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 10
    },
    {
      "id": "15-bruno",
      "speaker": "bruno",
      "text": "No todos. Empecé por galletitas. Después sigo con lácteos, conservas y congelados.",
      "start": 42.389,
      "end": 48.088,
      "voice": "es-AR-TomasNeural",
      "wordCount": 12
    },
    {
      "id": "16-valentina",
      "speaker": "valentina",
      "text": "¿Y cuándo pensás comprar algo?",
      "start": 48.138,
      "end": 50.099,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "17-bruno",
      "speaker": "bruno",
      "text": "Después.",
      "start": 50.149,
      "end": 51.81,
      "voice": "es-AR-TomasNeural",
      "wordCount": 1
    },
    {
      "id": "18-martina",
      "speaker": "martina",
      "text": "¿Viniste solo a estudiar?",
      "start": 51.86,
      "end": 53.773,
      "voice": "es-AR-ElenaNeural",
      "wordCount": 4
    },
    {
      "id": "19-valentina",
      "speaker": "valentina",
      "text": "¡Y acordate de comprar comida!",
      "start": 55.389,
      "end": 57.464,
      "voice": "es-UY-ValentinaNeural",
      "wordCount": 5
    },
    {
      "id": "20-bruno",
      "speaker": "bruno",
      "text": "Sí, sí...",
      "start": 57.789,
      "end": 59.45,
      "voice": "es-AR-TomasNeural",
      "wordCount": 2
    }
  ]
}

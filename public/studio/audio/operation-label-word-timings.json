      "end": 6.934,
      "wordCount": 6,
      "rate": "+7%",
      "pitch": "-7Hz",
      "volume": "+16%"
    },
    {
      "text": "Busqué la lista de ingredientes por todos lados...",
      "start": 8.1,
      "end": 11.412,
      "wordCount": 8,
      "rate": "+6%",
      "pitch": "-5Hz",
      "volume": "+17%"
    },
    {
      "text": "¡Pero no aparece por ninguna parte!",
      "start": 12.85,
      "end": 15.49,
      "wordCount": 6,
      "rate": "+8%",
      "pitch": "-2Hz",
      "volume": "+18%"
    },
    {
      "text": "¿Vos sabés cuáles tiene? Necesito que me ayudes.",

  "segments": [
    {
      "text": "¡Alto! Tenemos un nuevo caso.",
      "start": 0.25,
      "end": 3.73,
      "wordCount": 5,
      "rate": "+4%",
      "pitch": "-5Hz",
      "volume": "+16%"
    },
    {
      "text": "El sospechoso: un producto del súper.",

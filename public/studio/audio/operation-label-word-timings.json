  "durationSeconds": 30.0,
  "segments": [
    {
      "text": "¡Atención! Caso abierto.",
      "start": 0.25,
      "end": 3.322,
      "wordCount": 3,
      "rate": "+6%",
      "pitch": "-6Hz",
      "volume": "+16%"
    },
    {
      "text": "Tenemos un sospechoso: un alfajor Guaymallén.",
